# ─── Front Controller (SICAPDA) ───────────────────────────────────────────
# Toda requisição que NÃO aponte para um arquivo/pasta real (css, js, img,
# uploads, index.php) é enviada para o index.php, que carrega as rotas
# limpas definidas em app/routes/web.php (/login, /cadastro, /painel...).
#
# Este arquivo só funciona se o DocumentRoot do servidor apontar para esta
# pasta "public/" — é isso que impede o acesso direto a app/, config/,
# config/.env, ia/ e ao restante do projeto pela web.

RewriteEngine On

# ─── Endereço único para o Google: https://fluxeteam.com.br ─────────────────────────────────────
# www.fluxeteam.com.br e http:// são redirecionados (301) para https://fluxeteam.com.br, para o Google
# juntar tudo num só endereço em vez de dividir a relevância entre versões "duplicadas" do site.
# Só vale para o domínio de produção: localhost/XAMPP não são afetados.
RewriteCond %{HTTP_HOST} ^www\.fluxeteam\.com\.br$ [NC]
RewriteRule ^ https://fluxeteam.com.br%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^fluxeteam\.com\.br$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://fluxeteam.com.br%{REQUEST_URI} [R=301,L]

# Repassa o cabeçalho Authorization (Bearer token da API do app) ao PHP; o Apache/CGI o remove por padrão.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Se o caminho pedido já existe como arquivo ou diretório real, serve normalmente.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Caso contrário, encaminha tudo para o index.php (front controller).
RewriteRule ^ index.php [L]

# ─── Cabeçalhos de segurança básicos ───────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Bloqueia listagem de diretórios caso o servidor tenha Options +Indexes
Options -Indexes
