; Copie este arquivo para config/.env e preencha com os dados do seu servidor.
; O config/.env NÃO vai para o Git (está no .gitignore): é onde ficam as senhas.

; ─── Banco de dados MySQL ───────────────────────────────────────────────────
; No cPanel: DB_HOST=localhost; DB_NAME e DB_USER levam o prefixo da conta (fluxetea_...), e o usuário
; precisa estar associado ao banco em "Bancos de Dados MySQL" (com todos os privilégios).
; Em desenvolvimento local (XAMPP) use DB_HOST=127.0.0.1, DB_USER=root e a senha do seu MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fluxetea_controle_acesso
DB_USER=
DB_PASS=

; ─── Aplicativo (API /api/*) ────────────────────────────────────────────────
; Segredo que assina o login do aplicativo (mínimo de 32 caracteres). Sem ele (ou sem permissão
; de escrita em storage/), o app mostra "API não configurada no servidor".
; Para gerar um: php -r "echo bin2hex(random_bytes(32));"
API_SECRET=
