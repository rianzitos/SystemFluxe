# Copie para config/.env e ajuste (o .env real NÃO vai para o Git).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=controle_acesso
DB_USER=usuario
DB_PASS=senha

# Segredo usado para assinar os tokens da API do app mobile (mín. 32 caracteres).
# Gere com:  php -r "echo bin2hex(random_bytes(32));"
API_SECRET=troque-por-um-segredo-aleatorio-com-64-caracteres
