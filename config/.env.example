; Copie este arquivo para config/.env e preencha. O config/.env NUNCA vai para o Git (.gitignore).
; Valores com espaços ou símbolos ficam entre aspas.

; ─── Banco de dados ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=controle_acesso
DB_USER=root
DB_PASS=

; ─── API do aplicativo ───────────────────────────────────────────────────────
; Mínimo de 32 caracteres. Para gerar: php -r "echo bin2hex(random_bytes(32));"
; Também cifra as chaves do aplicativo autenticador (verificação em duas etapas). Defina uma vez e não troque:
; trocar desconecta todos do app e quem usa o aplicativo autenticador passa a entrar com um código de recuperação
; (e precisa ativar de novo em Configurações → Segurança).
API_SECRET=

; ─── Endereço público do site ────────────────────────────────────────────────
; Usado nos links dos e-mails (redefinir senha, abrir o painel). Sem barra no fim.
APP_URL=https://fluxeteam.com.br

; ─── E-mails automáticos ─────────────────────────────────────────────────────
; MAIL_DRIVER: smtp (recomendado) | mail (função mail() do servidor, costuma cair no spam)
;              | log (não envia: grava cada e-mail em storage/emails/*.eml, para testar)
MAIL_DRIVER=smtp

; Gmail: smtp.gmail.com, porta 587, MAIL_SECURE=tls, MAIL_USER = o endereço do Gmail e MAIL_PASS = uma
; "senha de app" (Conta Google → Segurança → Verificação em duas etapas → Senhas de app), nunca a senha normal.
; cPanel (e-mail do próprio domínio): mail.SEUDOMINIO.com.br, porta 465, MAIL_SECURE=ssl.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USER=
; Entre aspas se a senha tiver símbolos (! ; { } etc.).
MAIL_PASS=""

; Remetente (no Gmail, o mesmo endereço do MAIL_USER) e o nome que aparece na caixa de entrada.
MAIL_FROM=
MAIL_FROM_NAME="SICAPDA by Fluxe"

; Quem recebe as mensagens do formulário "Contato" das páginas / e /sicapda.
MAIL_CONTATO=fluxeteam@gmail.com

; Só se o cron da hospedagem não rodar comandos e precisar chamar uma URL:
; /tarefas/emails?chave=ESTE_VALOR (mínimo de 32 caracteres; vazio = rota desligada).
CRON_SECRET=

; ─── Assistente Virtual com IA (gratuito) ────────────────────────────────────
; Por padrão usa o Gemini, do Google, que tem plano gratuito sem cartão de crédito:
;   1. Entre em https://aistudio.google.com/apikey com uma conta Google e clique em "Criar chave de API".
;   2. Cole a chave abaixo. Pronto.
; Vazia = o assistente responde pelo motor local (palavras-chave, sem IA), como antes. A chave fica só no
; servidor; o navegador e o app nunca a veem.
IA_API_KEY=
; Modelo. gemini-2.5-flash-lite costuma ter limite diário maior no plano gratuito (um pouco menos capaz).
IA_MODEL=gemini-2.5-flash
; Endereço da API. Para outro provedor no mesmo formato (Groq, OpenRouter...), troque os três valores:
;   Groq:       https://api.groq.com/openai/v1
;   OpenRouter: https://openrouter.ai/api/v1
IA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
; Perguntas à IA por usuário por hora (0 = sem limite). Acima disso, responde o motor local.
ASSISTENTE_IA_LIMITE_HORA=40
